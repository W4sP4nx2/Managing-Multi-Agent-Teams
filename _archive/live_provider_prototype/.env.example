# Copy to .env and load only on your own computer. Never commit .env or keys.
# Replay makes zero provider requests and has no API charges.
FACTORY_MODE=replay
FACTORY_MODEL_CONFIG=software_factory/model_config.json
# Local application ledger limits in USD. Also configure provider account limits.
MAX_DAILY_SPEND=1.00
MAX_RUN_SPEND=1.00
# Required only after selecting live mode and approving the displayed routes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
